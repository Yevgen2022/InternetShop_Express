{
  "name": "internetshop-express",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "nodemon --ext js,json,pug ./bin/www",
    "tw:build:dev": "postcss ./src/styles/input.css -o ./public/stylesheets/styles.css",
    "tw:build": "NODE_ENV=production postcss ./src/styles/input.css -o ./public/stylesheets/styles.css",
    "tw:watch": "chokidar \"views/**/*.pug\" \"src/styles/**/*.css\" \"src/**/*.js\" \"tailwind.config.js\" -c \"npm run tw:build:dev\"",
    "dev": "concurrently \"npm:tw:watch\" \"npm:start\"",
    "build:css": "tailwindcss -i src/styles/input.css -o ./public/stylesheets/styles.css --minify --content \"./views/**/*.pug,./public/**/*.js,./src/**/*.js,./src/**/*.ts\""
  },
  "dependencies": {
    "@tailwindcss/line-clamp": "^0.4.4",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "morgan": "~1.9.1",
    "mysql2": "^3.15.3",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.13"
  }
}
