extends layout

block content
    h1.text-3xl.font-bold.mb-6.text-center.text-gray-800= title

    div(class="grid gap-6 px-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5")
      each val, index in data
        div(class="flex flex-col justify-between bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 p-4 text-center")
          div
            img(src=`/images/categories/${val.image}` alt=val.title class="w-full h-48 object-contain mb-3 mx-auto")
          div(class="flex-grow")
            h4(class="text-lg font-semibold text-gray-900 mb-2")
              a(href=`/categories/${val.url}` class="hover:text-blue-600 transition-colors")= val.title
          //-  p(class="text-gray-600 text-sm line-clamp-4")= val.description
