extends layout

block content
  div(class="w-full mx-auto px-10 py-10")
    h1(class="text-4xl font-bold text-center text-gray-900 mb-10")= data['title']

    div(class="bg-gray-200 shadow-lg rounded-2xl p-6 grid grid-cols-1 md:grid-cols-2 gap-8 items-center min-h-[400px]")
      // Ліва частина — опис
      div(class="flex flex-col justify-center")
        p(class="text-gray-700 text-lg leading-relaxed text-justify whitespace-pre-line")= data.description
          // Права частина — зображення
      div(class="flex justify-center items-center")
        img(
          src=`/images/categories/${data.image}`
          alt=data['title']
          class="max-h-80 object-contain rounded-lg"
        )
