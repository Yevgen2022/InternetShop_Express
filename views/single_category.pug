extends layout

block content
	div(class="w-full mx-auto px-10 py-10")
		h1(class="text-4xl font-bold text-center text-gray-900 mb-10")= data['title']
				each item in products
					div(class="flex flex-col justify-between bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 p-4 text-center")
						div
							img(
								src=`${item.image}`
								alt=item.title
								class="w-full h-48 object-contain mb-3 mx-auto"
							)
						div(class="flex-grow")
							h4(class="text-lg font-semibold text-gray-900 mb-2")
							a(
								href="#"
								class="hover:text-blue-600 transition-colors"
							)= item.title