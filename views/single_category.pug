extends layout

block content
  div(class="w-full mx-auto px-4 sm:px-6 lg:px-8 py-12")
    div(class="max-w-7xl mx-auto")
      h1(class="text-4xl font-bold text-center text-gray-800 mb-12")= data['title']

      div(class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6")
          each item in products
            div(class="bg-white border border-gray-300 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden")
              a(href=`/category/${item.slug || item.product_id}` class="block")
                div(class="p-6")
                  div(class="flex items-center justify-center h-48 mb-4 bg-gray-50 rounded-md")
                    img(
                      src=item.image
                      alt=item.title
                      class="max-h-full max-w-full object-contain"
                    )

                  div(class="text-center")
                    h4(class="text-lg font-semibold text-gray-800 mb-2 hover:text-blue-600 transition-colors")= item.title

                    if item.description
                      p(class="text-sm text-gray-600 line-clamp-2")= item.description

                    div(class="mt-4")
                      a(href=`/categories/${data['url']}/${item.product_url}` class="hover:text-blue-600 transition-colors")= item.title






